# Shared
ENVIRONMENT=local
API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
WIDGET_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1

# API
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ciet_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_COMMAND_TIMEOUT=20
JWT_SECRET=replace-with-a-64-character-random-secret
JWT_ISSUER=ciet-ai
JWT_AUDIENCE=ciet-admin
ACCESS_TOKEN_MINUTES=30
CSRF_COOKIE_DOMAIN=
PASSWORD_RESET_MINUTES=30
INVITATION_EXPIRY_HOURS=168
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OPENAI_API_KEY=
OFFICIAL_WEBSITE_URL=https://chalapathiengg.ac.in
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MINI_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_RETRIES=2
PINECONE_API_KEY=
PINECONE_INDEX=ciet-knowledge
PINECONE_NAMESPACE=ciet
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MAX_UPLOAD_BYTES=26214400
MULTIPART_OVERHEAD_BYTES=1048576
MAX_JSON_BODY_BYTES=65536
MAX_WEBHOOK_BODY_BYTES=1048576
CLAMAV_HOST=
CLAMAV_PORT=3310
ALLOWED_WIDGET_DOMAINS=localhost,127.0.0.1,ciet.edu,www.ciet.edu

# Cloudflare R2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ciet-ai-documents
LOCAL_STORAGE_PATH=storage/uploads

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Monitoring
SENTRY_DSN=
RATE_LIMIT=80/minute
AUTH_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=30/minute
RESPONSE_CACHE_SECONDS=120
EXPOSE_API_DOCS=true
EXPOSE_METRICS=true
