{
  "buildCommand": "npm run build -w @ciet/widget",
  "outputDirectory": "apps/widget/dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "headers": [
    {
      "source": "/ciet-ai.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
